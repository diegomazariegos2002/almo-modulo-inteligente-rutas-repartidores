# =============================================================
# Variables OPCIONALES de `docker compose up --build`.
#
# El sistema arranca sin este archivo: cada variable tiene un valor por
# defecto en docker-compose.yml. Copiarlo a .env solo si hay que cambiar
# un puerto ocupado o un secreto.
# =============================================================

# Puertos publicados en el host
FRONTEND_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5434

# Credenciales de PostgreSQL y Redis
POSTGRES_USER=almo
POSTGRES_PASSWORD=almo_dev_2026
REDIS_PASSWORD=almo_redis_dev_2026

# Secreto con el que se firman los JWT (HS256, mínimo 32 caracteres)
JWT_SECRET=secreto-de-demostracion-cambiar-fuera-de-la-prueba-2026
