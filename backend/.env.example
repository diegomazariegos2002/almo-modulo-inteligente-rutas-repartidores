# =============================================================
# Backend "rutas" — variables de entorno para desarrollo local.
# Copiar a .env. Requiere la infraestructura local:
#   pnpm docker:dev   (PostgreSQL en :5434 y Redis en :6380)
# =============================================================

NODE_ENV=development
PORT=3000

# PostgreSQL (base de datos `almo_ruta`, esquema `rutas`)
DATABASE_URL=postgresql://almo:almo_dev_2026@localhost:5434/almo_ruta

# Redis (caché de la ruta calculada de cada repartidor)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=almo_redis_dev_2026
CACHE_TTL_RUTA_SECONDS=300

# JWT (HS256). Usar un secreto propio de al menos 32 caracteres fuera de desarrollo.
JWT_SECRET=cambiar-este-secreto-de-desarrollo-0123456789
JWT_EXPIRES_IN_SECONDS=28800

ENABLE_SWAGGER=true
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
