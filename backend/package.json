{
  "name": "@almo/backend",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "prisma generate --config libs/prisma/prisma.config.ts",
    "start": "nx serve rutas",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test --coverage",
    "e2e": "nx run rutas-e2e:e2e",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:fix": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "quality:check": "nx run-many -t lint build && nx run-many -t test --coverage && prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "docker:dev": "docker compose -f ../infra/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f ../infra/docker-compose.dev.yml down",
    "docker:dev:reset": "docker compose -f ../infra/docker-compose.dev.yml down -v && docker compose -f ../infra/docker-compose.dev.yml up -d",
    "prisma:generate": "prisma generate --config libs/prisma/prisma.config.ts",
    "prisma:validate": "prisma validate --config libs/prisma/prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config libs/prisma/prisma.config.ts --name",
    "prisma:migrate:deploy": "prisma migrate deploy --config libs/prisma/prisma.config.ts",
    "prisma:migrate:status": "prisma migrate status --config libs/prisma/prisma.config.ts",
    "prisma:migrate:reset": "prisma migrate reset -f --config libs/prisma/prisma.config.ts",
    "prisma:seed": "ts-node -r tsconfig-paths/register -P libs/prisma/tsconfig.lib.json libs/prisma/src/lib/seed/seed.ts",
    "prisma:reseed": "pnpm prisma:migrate:reset && pnpm prisma:generate && pnpm prisma:seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.2.5",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.7.7",
    "@nx/eslint-plugin": "22.7.7",
    "@nx/jest": "22.7.7",
    "@nx/js": "22.7.7",
    "@nx/nest": "22.7.7",
    "@nx/node": "22.7.7",
    "@nx/web": "22.7.7",
    "@nx/webpack": "22.7.7",
    "@nx/workspace": "22.7.7",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "20.19.9",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "axios": "^1.18.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "22.7.7",
    "prettier": "~3.6.2",
    "prisma": "^7.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
